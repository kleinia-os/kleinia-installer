# SPDX-License-Identifier: GPL-3.0-or-later
# Kleinia installer (ReadyMade fork) packaging.
#
#   runtime   (default)  fedora:44 + the RPM — runnable demo image
#   artifacts             FROM scratch carrying /rpms/*.rpm — the artifact
#                         consumed by the kleinia assembly repo (artifacts.yml)
#
# The builder mirrors upstream CI (ghcr.io/terrapkg/builder:f44): it carries
# the Terra repo, from which libhelium — the one dependency missing from
# Fedora — is installed.

ARG FEDORA_VERSION=44
FROM ghcr.io/terrapkg/builder:f${FEDORA_VERSION} AS builder
RUN dnf -y install rust cargo clang-devel gcc mold cmake openssl-devel \
      gtk4-devel gnome-desktop4-devel libhelium-devel libacl-devel cryptsetup \
      curl tar git glibc-all-langpacks \
 && dnf clean all
ARG JUST_VERSION=1.59.0
ARG NFPM_VERSION=2.49.0
RUN curl -fsSL -o /tmp/just.tgz \
      https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz \
 && tar -xzf /tmp/just.tgz -C /usr/local/bin just \
 && curl -fsSL -o /tmp/nfpm.tgz \
      https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_Linux_x86_64.tar.gz \
 && tar -xzf /tmp/nfpm.tgz -C /usr/local/bin nfpm
WORKDIR /src
COPY . .
RUN just build && just test && just package

FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS runtime
RUN dnf -y install cryptsetup systemd-repart polkit && dnf clean all
COPY --from=builder /src/build-out/*.rpm /tmp/
RUN rpm -Uvh /tmp/*.rpm && rm -f /tmp/*.rpm
ENTRYPOINT ["/usr/bin/readymade"]

FROM scratch AS artifacts
COPY --from=builder /src/build-out/*.rpm /rpms/
