<?xml version="1.0" encoding="UTF-8" ?>
<gresources>
    <gresource prefix="/com/fyralabs/Readymade/">
        <file>style.css</file>
        <file>style-dark.css</file>
        <file>kleinia-welcome-light.webp</file>
        <file>kleinia-welcome-dark.webp</file>
        <file>kleinia-docs-light.webp</file>
        <file>kleinia-docs-dark.webp</file>
        <file>kleinia-community-light.webp</file>
        <file>kleinia-community-dark.webp</file>
    </gresource>
    <gresource prefix="/com/fyralabs/Readymade/icons/symbolic/actions/">
        <file
            preprocess="xml-stripblanks"
            alias="document-edit-symbolic.svg"
        >icons/document-edit-symbolic.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="edit-clear-symbolic.svg"
        >icons/edit-clear-symbolic.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="go-next.svg"
        >icons/go-next.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="errornext.svg"
        >icons/errornext.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="content-loading-symbolic.svg"
        >icons/content-loading-symbolic.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="list-remove-all-symbolic.svg"
        >icons/list-remove-all-symbolic.svg</file>
        <file
            preprocess="xml-stripblanks"
            alias="dialog-error-symbolic.svg"
            >icons/dialog-error-symbolic.svg</file>
    </gresource>
    <!-- Kleinia bento card icons: a standard hicolor subdir so GtkIconTheme finds them -->
    <gresource prefix="/com/fyralabs/Readymade/icons/scalable/actions/">
        <file preprocess="xml-stripblanks" alias="kleinia-docs-symbolic.svg">icons/kleinia-docs-symbolic.svg</file>
        <file preprocess="xml-stripblanks" alias="kleinia-community-symbolic.svg">icons/kleinia-community-symbolic.svg</file>
    </gresource>
</gresources>
